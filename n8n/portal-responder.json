{
  "name": "Encorpa — Portal responder",
  "nodes": [
    {
      "name": "Pedido do portal",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2.1,
      "position": [
        0,
        200
      ],
      "parameters": {
        "httpMethod": "POST",
        "path": "portal-responder",
        "responseMode": "responseNode",
        "options": {}
      }
    },
    {
      "name": "Confere a chave",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [
        220,
        200
      ],
      "onError": "continueErrorOutput",
      "parameters": {
        "method": "GET",
        "url": "https://encorpa-fashion.pikapod.net/api/v1/workflows?limit=1",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-N8N-API-KEY",
              "value": "={{ $json.headers['x-n8n-api-key'] ?? '' }}"
            }
          ]
        },
        "options": {
          "timeout": 10000
        }
      }
    },
    {
      "name": "Grava a resposta",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [
        440,
        100
      ],
      "onError": "continueErrorOutput",
      "credentials": {
        "httpHeaderAuth": {
          "id": "uNGrb6LchX9rT743",
          "name": "Supabase service_role"
        }
      },
      "parameters": {
        "method": "POST",
        "url": "https://hbmkgakzrqmdlsvszjeo.supabase.co/functions/v1/turn",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ job: \"human_reply\", phone: String($('Pedido do portal').first().json.body?.phone ?? ''), text: String($('Pedido do portal').first().json.body?.text ?? '') }) }}",
        "options": {
          "timeout": 30000
        }
      }
    },
    {
      "name": "Pode enviar?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        660,
        0
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "leftValue": "={{ $json.status }}",
              "rightValue": "ready",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "name": "Envia pelo WhatsApp",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1.2,
      "position": [
        880,
        -100
      ],
      "parameters": {
        "workflowId": {
          "__rl": true,
          "mode": "id",
          "value": "GehzRG0OhJ4FtBm9",
          "cachedResultName": "Encorpa — WhatsApp envio"
        },
        "mode": "each",
        "options": {
          "waitForSubWorkflow": false
        }
      }
    },
    {
      "name": "Enviada",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.5,
      "position": [
        1100,
        -100
      ],
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ status: \"sent\" }) }}",
        "options": {}
      }
    },
    {
      "name": "Não enviada",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.5,
      "position": [
        880,
        100
      ],
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ status: \"refused\", reason: $json.reason ?? null, message: $json.message ?? \"A resposta não pôde sair.\" }) }}",
        "options": {
          "responseCode": 200
        }
      }
    },
    {
      "name": "Erro na Edge Function",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.5,
      "position": [
        660,
        250
      ],
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ status: \"error\", message: \"A Edge Function recusou a chamada: \" + String($json.error?.message ?? \"erro sem mensagem\") }) }}",
        "options": {
          "responseCode": 502
        }
      }
    },
    {
      "name": "Sem permissão",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.5,
      "position": [
        440,
        350
      ],
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ status: \"error\", message: \"chave do portal recusada\" }) }}",
        "options": {
          "responseCode": 401
        }
      }
    }
  ],
  "connections": {
    "Pedido do portal": {
      "main": [
        [
          {
            "node": "Confere a chave",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Confere a chave": {
      "main": [
        [
          {
            "node": "Grava a resposta",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Sem permissão",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Grava a resposta": {
      "main": [
        [
          {
            "node": "Pode enviar?",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Erro na Edge Function",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Pode enviar?": {
      "main": [
        [
          {
            "node": "Envia pelo WhatsApp",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Não enviada",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Envia pelo WhatsApp": {
      "main": [
        [
          {
            "node": "Enviada",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "callerPolicy": "workflowsFromSameOwner"
  }
}